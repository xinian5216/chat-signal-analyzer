      "baseline": "rb_init_passive",
      "contrast": "rb_init_probe",
      "issue_bullet": "主动性：被动回应 vs 连续主动追问",
      "factor": "只把目标消息从顺从收束换成一条消息内连续三个具体追问",
      "expected_distinguishers": [
        "engagement：contrast 明显更高",
        "relationship_evidence_strength：contrast 更高",
        "warmth：contrast 略高（可解释性差异不应过大）"
