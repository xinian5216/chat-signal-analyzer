        {"speaker": "me", "time": "2026-03-02 10:00", "text": "今天有空吗"},
        {"speaker": "them", "time": "2026-03-02 10:01", "text": "有"},
        {"speaker": "me", "time": "2026-03-02 10:02", "text": "那出来吗"},
        {"speaker": "them", "time": "2026-03-02 10:03", "text": "可以"},
        {"speaker": "me", "time": "2026-03-02 10:04", "text": "周六呢"},
