{
  "version": "interaction-scenarios-v0.4",
  "meta": {
    "provenance": "synthetic",
    "disclaimer": "人工构造的合成场景：只能证明“若消息与 Jev 信号是这样，本地互动结构引擎会发生什么”，绝不证明真实聊天会如此，也不构成真实准确率。",
    "case_set": "Issue #20 §45 I1~I24",
    "materializer": "interaction_diagnostics.materialize_case（确定性：TA 文本消息得到同形 structured result）",
    "authoring": "每条消息的说话方 / 时间 / 文本按场景语义人工构造；TA 的 result spec 模拟九问输出（分数与概率分布一致，score 等于概率期望）。",
    "expectation_semantics": "expectation 由 interaction_diagnostics.evaluate_case 做约束检查（确定性），不是模型判分；全部场景默认做 prefix invariance 检查。",
    "scenario_notes": "I20 同时是 future-leakage 基准（运行 messages[:5] 不得产生完整运行才有的 recall 事件）。"
  },
  "cases": [
    {
      "id": "I1_plain_qa_no_followup",
      "scenario": "I1",
      "title": "普通问答不得产生连续追问",
      "description": "我问 TA 答两次，是普通问答，不是“对我的事情持续追问”。",
      "messages": [
        {"speaker": "me", "time": "2026-03-02 10:00", "text": "几点开会？"},
        {"speaker": "them", "time": "2026-03-02 10:01", "text": "三点。",
         "result": {"intent": "confirm_understanding", "intent_probs": {"confirm_understanding": 0.9, "other": 0.1}}},
        {"speaker": "me", "time": "2026-03-02 10:02", "text": "会议室在哪？"},
        {"speaker": "them", "time": "2026-03-02 10:03", "text": "二楼。",
         "result": {"intent": "confirm_understanding", "intent_probs": {"confirm_understanding": 0.9, "other": 0.1}}}
      ],
      "expectation": {
        "event_types": {"followup_sequence": {"min": 0, "max": 0}},
        "forbidden_event_types": ["followup_sequence", "conversation_reengagement", "personal_recall_candidate", "boundary_pressure", "boundary_accepted", "boundary_adjusted", "boundary_ambiguous"],
        "notes": "普通问答不是持续追问。"
      }
    },
    {
      "id": "I2_followup_sequence",
      "scenario": "I2",
      "title": "连续主动追问",
      "description": "用户陈述 → TA 提问 → 用户回应 → TA 再提问。",
      "messages": [
        {"speaker": "me", "time": "2026-03-02 10:00", "text": "最近胃不舒服"},
        {"speaker": "them", "time": "2026-03-02 10:01", "text": "怎么了？",
         "result": {"intent": "ask_information", "intent_probs": {"ask_information": 0.85, "other": 0.15}}},
        {"speaker": "me", "time": "2026-03-02 10:02", "text": "可能吃坏了"},
        {"speaker": "them", "time": "2026-03-02 10:03", "text": "现在还疼吗？",
         "result": {"intent": "ask_information", "intent_probs": {"ask_information": 0.9, "other": 0.1}}}
      ],
      "expectation": {
        "event_types": {"followup_sequence": {"min": 1, "max": 1, "dimension": "initiative", "review_status": "auto_supported"}},
        "forbidden_event_types": ["personal_recall_candidate", "boundary_pressure", "conversation_reengagement"],
        "mapping": {"initiative_engagement": {"salient_min": 1, "salient_max": 1},
                    "care_responsiveness": {"salient_max": 0}},
        "notes": "连续追问是结构观察；本场景无 care 结构化信号，不得映射 care。"
      }
    },
    {
      "id": "I3_ta_after_gap_reengagement",
      "scenario": "I3",
      "title": "TA 在明显间隔后恢复互动",
      "description": "第一天道别后，第三天 TA 先发消息。",
      "messages": [
        {"speaker": "me", "time": "2026-03-01 20:00", "text": "今天先聊到这"},
        {"speaker": "them", "time": "2026-03-01 20:01", "text": "好，辛苦了"},
        {"speaker": "them", "time": "2026-03-03 09:00", "text": "早上好，那个文件我带过来了"}
      ],
      "expectation": {
        "event_types": {"conversation_reengagement": {"min": 1, "max": 1, "actor": "TA"}},
        "forbidden_event_types": ["personal_recall_candidate", "boundary_pressure", "followup_sequence"],
        "mapping": {"initiative_engagement": {"salient_min": 1, "salient_max": 1},
                    "special_attention": {"salient_max": 0},
                    "romantic": {"salient_max": 0}},
        "notes": "重启是可观察结构；不代表想念或特殊关注。"
      }
    },
    {
      "id": "I4_user_after_gap_reengagement",
      "scenario": "I4",
      "title": "用户在明显间隔后恢复互动",
      "description": "用户先重启 → 不是 TA 主动。",
      "messages": [
        {"speaker": "me", "time": "2026-03-01 20:00", "text": "先这样，拜拜"},
        {"speaker": "them", "time": "2026-03-01 20:01", "text": "好"},
        {"speaker": "me", "time": "2026-03-03 09:00", "text": "早啊，在忙吗"}
      ],
      "expectation": {
        "event_types": {"conversation_reengagement": {"min": 1, "max": 1, "actor": "用户", "direction": "observation"}},
        "forbidden_event_types": ["personal_recall_candidate", "boundary_pressure"],
        "mapping": {"initiative_engagement": {"salient_max": 0}},
        "notes": "用户重启是 observation，不得算 TA 主动。"
      }
    },
    {
      "id": "I5_ta_restart_transactional",
      "scenario": "I5",
      "title": "TA 重启后只是事务",
      "description": "TA 间隔后发文件通知：允许 restart observation，禁止 special/romantic。",
      "messages": [
        {"speaker": "me", "time": "2026-03-01 20:00", "text": "今天先聊到这"},
        {"speaker": "them", "time": "2026-03-01 20:01", "text": "好"},
        {"speaker": "them", "time": "2026-03-03 09:00", "text": "那个文件发你了，记得查收"}
      ],
      "expectation": {
        "event_types": {"conversation_reengagement": {"min": 1, "max": 1, "actor": "TA"}},
        "forbidden_event_types": ["personal_recall_candidate", "boundary_pressure", "explicit_care_behavior", "explicit_special_attention"],
        "mapping": {"initiative_engagement": {"salient_min": 1, "salient_max": 1},
                    "special_attention": {"salient_max": 0},
                    "romantic": {"salient_max": 0},
                    "care_responsiveness": {"salient_max": 0}},
        "notes": "restart 只进 initiative；不得升级 special/romantic。"
      }
    },
    {
      "id": "I6_invitation_vague_to_concrete",
      "scenario": "I6",
      "title": "模糊邀请 → 具体时间地点",
      "description": "同一行为人邀约从缺少安排走向包含时间与地点。",
      "messages": [
        {"speaker": "me", "time": "2026-03-05 12:00", "text": "这周忙死了"},
        {"speaker": "them", "time": "2026-03-05 12:01", "text": "忙完有空一起吃饭",
         "result": {"intent": "invite", "intent_probs": {"invite": 0.8, "other": 0.2}}},
        {"speaker": "me", "time": "2026-03-05 12:05", "text": "好啊"},
        {"speaker": "them", "time": "2026-03-05 12:06", "text": "那周六六点，公司楼下见",
         "result": {"intent": "invite", "intent_probs": {"invite": 0.85, "other": 0.15}}}
      ],
      "expectation": {
        "event_types": {"invitation_progression": {"min": 1, "max": 1, "dimension": "initiative"}},
        "party_structure": "unknown",
        "forbidden_event_types": ["personal_recall_candidate", "boundary_pressure"],
        "mapping": {"initiative_engagement": {"salient_min": 1, "salient_max": 1},
                    "romantic": {"salient_max": 0}},
        "notes": "文本不足以判定群体/双人结构时按 unknown；邀约推进不进 romantic。"
      }
    },
    {
      "id": "I7_group_invitation",
      "scenario": "I7",
      "title": "群体邀请",
      "description": "“大家一起吃饭”：群体结构；不得 romantic。",
      "messages": [
        {"speaker": "them", "time": "2026-03-05 18:00", "text": "周末大家一起吃饭？",
         "result": {"intent": "invite", "intent_probs": {"invite": 0.85, "other": 0.15}, "warmth": 2.6, "engagement": 3.0}}
      ],
      "expectation": {
        "event_types": {},
        "forbidden_event_types": ["invitation_progression", "personal_recall_candidate", "boundary_pressure", "explicit_romantic_signal", "explicit_special_attention"],
        "mapping": {"romantic": {"salient_max": 0}, "special_attention": {"salient_max": 0}},
        "notes": "群体结构明确；高 invite/engagement 不得制造 romantic/special。"
      }
    },
    {
      "id": "I8_dyadic_invitation",
      "scenario": "I8",
      "title": "明确双人邀请",
      "description": "“就咱俩去看电影”：双人结构；仍不得自动 romantic。",
      "messages": [
        {"speaker": "them", "time": "2026-03-05 18:00", "text": "就咱俩去看电影？",
         "result": {"intent": "invite", "intent_probs": {"invite": 0.9, "other": 0.1}, "warmth": 2.8}}
      ],
      "expectation": {
        "event_types": {},
        "forbidden_event_types": ["invitation_progression", "personal_recall_candidate", "boundary_pressure", "explicit_romantic_signal", "explicit_special_attention"],
        "mapping": {"romantic": {"salient_max": 0}},
        "notes": "双人结构 ≠ romantic；浪漫只能由 romantic Jev 通道自己判断。"
      }
    },
    {
      "id": "I9_refusal_then_accepted",
      "scenario": "I9",
      "title": "明确拒绝 → TA 接受",
      "description": "边界压力的相反证据（不推断人格）。",
      "messages": [
        {"speaker": "me", "time": "2026-03-06 19:00", "text": "今天不想去"},
        {"speaker": "them", "time": "2026-03-06 19:01", "text": "好，那不去了"}
      ],
      "expectation": {
        "event_types": {"boundary_accepted": {"min": 1, "max": 1, "review_status": "auto_supported", "direction": "counter"}},
        "forbidden_event_types": ["boundary_pressure", "boundary_continued_request", "personal_recall_candidate"],
        "observations": {"boundary_opportunities": {"min": 1, "max": 1}},
        "boundary": {"status": "evidence_limited", "counter_min": 1, "pressure_max": 0},
        "notes": "接受边界是相反证据；不是“TA 尊重你”的人格结论。"
      }
    },
    {
      "id": "I10_refusal_then_adjusted",
      "scenario": "I10",
      "title": "明确拒绝 → TA 正常调整",
      "description": "“今天不行” → “行，那改周日？”是正常调整。",
      "messages": [
        {"speaker": "me", "time": "2026-03-06 19:00", "text": "今天不行"},
        {"speaker": "them", "time": "2026-03-06 19:01", "text": "行，那改周日？"}
      ],
      "expectation": {
        "event_types": {"boundary_adjusted": {"min": 1, "max": 1, "review_status": "auto_supported", "direction": "counter"}},
        "forbidden_event_types": ["boundary_pressure", "boundary_ambiguous", "personal_recall_candidate"],
        "observations": {"boundary_opportunities": {"min": 1, "max": 1}},
        "boundary": {"status": "evidence_limited", "counter_min": 1, "pressure_max": 0},
        "notes": "调整时间是相反证据（结构观察），不是人格判断。"
      }
    },
    {
      "id": "I11_refusal_then_pressure",
      "scenario": "I11",
      "title": "明确拒绝 → TA 继续施压",
      "description": "D5 正式通道：拒绝后仍持续推进同一请求。",
      "messages": [
        {"speaker": "me", "time": "2026-03-06 19:00", "text": "我不想去"},
        {"speaker": "them", "time": "2026-03-06 19:01", "text": "就来嘛"},
        {"speaker": "me", "time": "2026-03-06 19:02", "text": "真的不去"},
        {"speaker": "them", "time": "2026-03-06 19:03", "text": "来吧，就一会"}
      ],
      "expectation": {
        "event_types": {"boundary_pressure": {"min": 1, "max": 2, "review_status": "auto_supported", "direction": "supporting"}},
        "forbidden_event_types": ["boundary_accepted", "boundary_adjusted", "personal_recall_candidate"],
        "observations": {"boundary_opportunities": {"min": 2, "max": 2}},
        "boundary": {"status": "evidence_limited", "pressure_min": 1, "counter_max": 0},
        "notes": "这是 boundary_pressure 的 supporting evidence（结构观察），不再依赖 legacy base_score。"
      }
    },
    {
      "id": "I12_soft_reschedule_not_pressure",
      "scenario": "I12",
      "title": "软性改期不得误判施压",
      "description": "“今天不行，改天吧” + “好的”是接受，不是压力。",
      "messages": [
        {"speaker": "me", "time": "2026-03-06 19:00", "text": "今天不行，改天吧"},
        {"speaker": "them", "time": "2026-03-06 19:01", "text": "好的"}
      ],
      "expectation": {
        "event_types": {"boundary_accepted": {"min": 1, "max": 1}},
        "forbidden_event_types": ["boundary_pressure", "boundary_continued_request", "personal_recall_candidate"],
        "observations": {"boundary_opportunities": {"min": 1, "max": 1}},
        "notes": "软性改期后的接受不是施压。"
      }
    },
    {
      "id": "I13_reciprocity_both_sides",
      "scenario": "I13",
      "title": "双向提问 / 分享",
      "description": "互惠结构观察：只数 turn，不给百分比。",
      "messages": [
        {"speaker": "me", "time": "2026-03-02 10:00", "text": "你今天怎么样？"},
        {"speaker": "them", "time": "2026-03-02 10:01", "text": "挺好的，你呢？",
         "result": {"intent": "ask_information", "intent_probs": {"ask_information": 0.7, "other": 0.3}}},
        {"speaker": "me", "time": "2026-03-02 10:02", "text": "我也不错，周末去爬山了"},
        {"speaker": "them", "time": "2026-03-02 10:03", "text": "我周末去钓鱼了",
         "result": {"intent": "share_personal", "intent_probs": {"share_personal": 0.8, "other": 0.2}}}
      ],
      "expectation": {
        "event_types": {},
        "forbidden_event_types": ["followup_sequence", "personal_recall_candidate", "boundary_pressure"],
        "observations": {"reciprocity": {"sufficient": true, "me_question_min": 1, "ta_question_min": 1, "ta_share_min": 1, "me_share_min": 1}},
        "notes": "互惠只输出结构观察（含“仅描述当前导入样本”免责句）。"
      }
    },
    {
      "id": "I14_one_sided_questions",
      "scenario": "I14",
      "title": "长期单侧提问样本",
      "description": "只描述当前样本，不人格化。",
