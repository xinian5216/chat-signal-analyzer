      "expected_distinguishers": [
        "romantic_signal：contrast 显著更高（≥0.7）",
        "warmth / special_attention / evidence：contrast 均更高",
        "distancing_signal：两边都低"
      ]
    },
    {
      "pair_id": "R2_date_context",
      "family": "romantic",
      "baseline": "rb_rom_plain_invite",
      "contrast": "rb_rom_date_context",
