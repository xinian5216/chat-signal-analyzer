      "expected_distinguishers": [
        "romantic_signal：contrast 明显更高",
        "special_attention：contrast 明显更高"
      ]
    },
    {
      "pair_id": "R3_explicit_like",
      "family": "romantic",
      "baseline": "rb_rom_teasing_flirt",
      "contrast": "rb_rom_explicit_like",
      "issue_bullet": "浪漫：调侃式暧昧 vs 明确表达喜欢",
      "factor": "只把目标消息从玩笑话风换成明确排除玩笑解读的表白",
      "expected_distinguishers": [
        "romantic_signal：contrast 明显更高",
        "relationship_evidence_strength：contrast 更高"
      ]
    },
    {
      "pair_id": "D5_boundary_pressure",
      "family": "boundary",
      "baseline": "rb_dis_respect_boundary",
      "contrast": "rb_dis_pressure_after_refusal",
      "issue_bullet": "疏离/边界：拒绝后尊重边界 vs 拒绝后继续施压",
      "factor": "共享同一段“我方拒绝”上下文，只把目标消息从接受边界换成继续施压",
      "expected_distinguishers": [
        "relationship_evidence_strength：两边都高（方向相反）",
        "engagement / special_attention：施压侧可能反而更高——base_score 的方向语义问题，报告必须如实记录",
        "distancing_signal：尊重边界侧不应判高（浪漫边界 ≠ 疏离）"
      ]
    }
